# Instagram Graph API — required for the live @foodtalkindia feed.
# Needs an Instagram Business/Creator account linked to a Facebook Page.
# Docs: https://developers.facebook.com/docs/instagram-api/getting-started
#
# 1. Create a Facebook App (Business type) at developers.facebook.com
# 2. Add the "Instagram Graph API" product, link the FB Page + IG account
# 3. Generate a long-lived access token (60-day; refresh via cron/route)
# 4. Get your IG business account id from the Graph API Explorer
#
# Copy this file to .env.local and fill in the values:

INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# Zoho CRM Leads API — connects all website forms directly to Zoho CRM
# Same integration as Shuchir's website (using accounts.zoho.in / zohoapis.in)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
